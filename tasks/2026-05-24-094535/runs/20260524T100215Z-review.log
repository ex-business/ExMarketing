	`, quota.ID, quota.ActivityID, quota.Type, quota.Scope, quota.ScopeKey,
		emptyDecimal(quota.TotalValue), emptyDecimal(quota.UsedValue), emptyDecimal(quota.FrozenValue),
		quota.Version, quota.CreatedAt, quota.UpdatedAt)
	return quota, err
}

