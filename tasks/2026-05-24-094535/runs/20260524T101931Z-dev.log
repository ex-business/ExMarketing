 			continue
 		}
diff --git a/internal/marketing/memory_repository_test.go b/internal/marketing/memory_repository_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a762d5c478af2b6719531a4be387c44f9c7d4739
