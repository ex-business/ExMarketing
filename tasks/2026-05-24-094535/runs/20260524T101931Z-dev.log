			order.GrantChannel, order.RetryCount, nullString(order.ErrorMessage), order.IdempotencyKey, order.CreatedAt, order.UpdatedAt)
		if err != nil {
			return nil, nil, false, err
		}
	}
	for _, message := range messages {
		_, err = tx.ExecContext(ctx, `
