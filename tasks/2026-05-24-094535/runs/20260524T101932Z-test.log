package marketing

import (
	"context"
	"time"
)

type Repository interface {
	CreateActivity(ctx context.Context, activity Activity) (Activity, error)
	ListActivities(ctx context.Context) ([]Activity, error)
	FindMatchingActivities(ctx context.Context, tenantID string, eventType string) ([]Activity, error)

	CreateInbox(ctx context.Context, inbox EventInbox) (EventInbox, bool, error)
	UpdateInbox(ctx context.Context, inbox EventInbox) error

	CreateParticipation(ctx context.Context, participation Participation) (Participation, error)
	CreateGrantOrder(ctx context.Context, order GrantOrder) (GrantOrder, error)
	UpdateGrantOrderByCommandID(ctx context.Context, tenantID string, commandID string, status GrantStatus, message string) error
	CreateOutbox(ctx context.Context, message OutboxMessage) (OutboxMessage, error)
	CreateGrantOutboxesWithQuota(ctx context.Context, activityID string, subjectID string, totalRewardAmount string, reserveUserLimit bool, orders []GrantOrder, messages []OutboxMessage) ([]GrantOrder, []OutboxMessage, bool, error)

	CreateQuota(ctx context.Context, quota Quota) (Quota, error)
	ReserveQuota(ctx context.Context, activityID string, quotaType QuotaType, scope QuotaScope, scopeKey string, amount string) (bool, error)

	ListPendingOutbox(ctx context.Context, limit int) ([]OutboxMessage, error)
	MarkOutboxSent(ctx context.Context, id string) error
	MarkOutboxFailed(ctx context.Context, id string, retryCount int, nextRetryAt time.Time, message string) error
	MarkOutboxDLQ(ctx context.Context, id string, message string) error

	CreateAudit(ctx context.Context, record AuditRecord) error
	ListAudit(ctx context.Context, limit int) ([]AuditRecord, error)
}
	})
}

func (r *MemoryRepository) CreateAudit(ctx context.Context, record AuditRecord) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	r.mu.Lock()
	defer r.mu.Unlock()
	r.auditRecords = append(r.auditRecords, record)
	return nil
}

func (r *MemoryRepository) ListAudit(ctx context.Context, limit int) ([]AuditRecord, error) {
	if err := ctx.Err(); err != nil {
		return nil, err
	}
	r.mu.RLock()
	defer r.mu.RUnlock()
	if limit <= 0 || limit > len(r.auditRecords) {
		limit = len(r.auditRecords)
	}
	out := slices.Clone(r.auditRecords[:limit])
	return out, nil
}

func (r *MemoryRepository) updateOutbox(ctx context.Context, id string, update func(*OutboxMessage)) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	r.mu.Lock()
	defer r.mu.Unlock()
	for i := range r.outboxMessages {
		if r.outboxMessages[i].ID == id {
			update(&r.outboxMessages[i])
			return nil
		}
	}
	return ErrNotFound
}

func (r *MemoryRepository) reserveQuotaLocked(activityID string, quotaType QuotaType, scope QuotaScope, scopeKey string, amount string) bool {
	for i := range r.quotas {
		q := &r.quotas[i]
		if q.ActivityID != activityID || q.Type != quotaType || q.Scope != scope || q.ScopeKey != scopeKey {
			continue
		}
		total := decimal.MustParse(q.TotalValue)
		used := decimal.MustParse(q.UsedValue)
		increment := decimal.MustParse(amount)
		next := used.Add(increment)
		if next.Cmp(total) > 0 {
			return false
		}
		q.UsedValue = next.String()
		q.Version++
		q.UpdatedAt = time.Now().UTC()
		return true
	}
	return true
}

func (r *MemoryRepository) releaseQuotaLocked(activityID string, quotaType QuotaType, scope QuotaScope, scopeKey string, amount string) {
	for i := range r.quotas {
		q := &r.quotas[i]
		if q.ActivityID != activityID || q.Type != quotaType || q.Scope != scope || q.ScopeKey != scopeKey {
			continue
		}
		used := decimal.MustParse(q.UsedValue)
		decrement := decimal.MustParse("-" + amount)
		q.UsedValue = used.Add(decrement).String()
		q.Version++
		q.UpdatedAt = time.Now().UTC()
		return
	}
}

