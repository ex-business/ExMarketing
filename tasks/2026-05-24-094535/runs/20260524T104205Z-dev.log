func (e QuotaExceededError) Error() string {
	parts := []string{"quota exceeded"}
	if e.Type != "" {
		parts = append(parts, string(e.Type))
	}
	if e.Scope != "" {
		parts = append(parts, string(e.Scope))
	}
	if e.ScopeKey != "" {
		parts = append(parts, e.ScopeKey)
	}
	return strings.Join(parts, ": ")
}

