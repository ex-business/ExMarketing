{
  "name": "exmarketing",
  "version": "1.0.0",
  "description": "`ExMarketing` is a standalone marketing system under `ex-stack`.",
  "private": true,
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:admin-flow": "vite build --config frontend/admin-flow/vite.config.ts",
    "dev:admin-flow": "vite --config frontend/admin-flow/vite.config.ts --host 127.0.0.1",
    "e2e:admin-flow": "playwright test --config frontend/admin-flow/playwright.config.ts",
    "e2e:admin-flow:ci": "node frontend/admin-flow/e2e/run-ci.mjs",
    "e2e:admin-flow:cleanup": "node frontend/admin-flow/e2e/cleanup-fixtures.mjs",
    "clean:admin-flow-artifacts": "node frontend/admin-flow/e2e/cleanup-artifacts.mjs",
    "typecheck:admin-flow": "tsc -p frontend/admin-flow/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ex-business/ExMarketing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ex-business/ExMarketing/issues"
  },
  "homepage": "https://github.com/ex-business/ExMarketing#readme",
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.2"
  }
}
